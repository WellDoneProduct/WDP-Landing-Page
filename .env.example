NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
# Only needed for a private dataset; server-side only.
SANITY_API_READ_TOKEN=
WDP_ENVIRONMENT=development
# Enable visual review routes only on the isolated development deployment.
WDP_DESIGN_PREVIEW=true

# Local-only static design samples; false uses the actual CMS.
WDP_LOCAL_DESIGN_PREVIEW=false

# Search indexing requires BOTH WDP_ENVIRONMENT=production and NEXT_PUBLIC_SANITY_DATASET=production.
# Vercel preview deployments always stay noindex.
